{
  "schemaVersion": 4,
  "project": {
    "name": "com-design-prototype",
    "title": "Com Design Prototype"
  },
  "repository": {
    "provider": "github",
    "url": null
  },
  "targets": {
    "mobile": true,
    "pc": true
  },
  "design": {
    "preset": "com-design",
    "icons": "lucide"
  },
  "versioning": {
    "strategy": "semver",
    "currentVersion": "0.3.0",
    "initialProjectVersion": "0.1.0",
    "versionFile": "VERSION",
    "changelogFile": "CHANGELOG.md"
  },
  "deployment": {
    "githubPages": {
      "enabled": false
    },
    "cloudflare": {
      "enabled": false,
      "provider": "pages",
      "projects": {
        "mobile": "com-design-prototype-mobile",
        "pc": "com-design-prototype-pc"
      }
    }
  },
  "workflow": {
    "developmentBranch": "dev",
    "productionBranch": "prod",
    "longLivedBranches": ["dev", "prod"],
    "usesMainForProductWork": false,
    "previewEnvironment": "preview",
    "productionEnvironment": "production"
  },
  "workbench": {
    "enabled": true,
    "taskPrefix": "T",
    "dailyReport": {
      "skill": "docs/ai/skills/daily-report.md",
      "outputDirectory": "docs/reports/daily"
    }
  }
}
