{
  "schemaVersion": 3,
  "project": {
    "name": "com-design-prototype",
    "title": "Com Design Prototype"
  },
  "targets": {
    "mobile": true,
    "pc": true
  },
  "design": {
    "preset": "com-design",
    "icons": "lucide"
  },
  "versioning": {
    "strategy": "semver",
    "currentVersion": "0.2.0",
    "initialProjectVersion": "0.1.0",
    "versionFile": "VERSION",
    "changelogFile": "CHANGELOG.md"
  },
  "deployment": {
    "githubPages": {
      "enabled": false
    },
    "cloudflare": {
      "enabled": false,
      "provider": "pages",
      "projects": {
        "mobile": "com-design-prototype-mobile",
        "pc": "com-design-prototype-pc"
      }
    }
  },
  "workflow": {
    "developmentBranch": "dev",
    "productionBranch": "prod",
    "previewEnvironment": "preview",
    "productionEnvironment": "production"
  },
  "workbench": {
    "enabled": true,
    "taskPrefix": "T"
  }
}
